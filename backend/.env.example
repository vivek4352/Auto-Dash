# ---- Google login (required for uploads) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com             # from Google Cloud Console, see README > Google login
JWT_SECRET=replace-with-a-secure-random-secret        # long random string; sessions are signed with it. NEVER keep the default in production
# AUTH_DEV_MODE=1             # LOCAL TESTING ONLY: shows a 'Continue as demo user' button so you can try the app without Google
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=25
MAX_ROWS=200000
MAX_DATASETS_PER_USER=25
DATA_DIR=./data               # users, saved dashboards and their data live here (back this folder up)
GEMINI_API_KEY=               # optional: only rephrases insights / understands chat questions
GEMINI_MODEL_SPEC=gemini-1.5-flash
GEMINI_MODEL_CHAT=gemini-1.5-flash
